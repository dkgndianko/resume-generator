    "eslint-config-react-app": "^7.0.1",
    "gh-pages": "^3.1.0",
    "gulp": "^4.0.2",
    "gulp-cli": "^2.3.0",
    "gulp-inline-source": "^4.0.0",
    "gulp-replace": "^1.1.3",
    "gulp-task-listing": "^1.1.0",
    "jest": "^30.4.2",
    "lerna": "^4.0.0",
    "puppeteer": "^25.3.0",
    "storybook-addon-jsx": "^7.3.9",
    "ts-loader": "^9.6.2",
