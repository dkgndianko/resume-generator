  "scripts": {
    "start": "react-scripts start",
    "build": "SKIP_PREFLIGHT_CHECK=true react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "storybook": "start-storybook -p 6001 -c .storybook",
    "predeploy": "yarn build",
    "deploy": "gh-pages -d build",
    "inline-build": "NODE_OPTIONS=--openssl-legacy-provider INLINE_RUNTIME_CHUNK=false GENERATE_SOURCEMAP=false SKIP_PREFLIGHT_CHECK=true gulp --gulpfile gulpfile.cjs inline-build",
    "_gen-pdf": "NODE_OPTIONS=--openssl-legacy-provider gulp --gulpfile gulpfile.cjs resume-pdf-gen",
    "gen-pdf": "NODE_OPTIONS=--openssl-legacy-provider SKIP_PREFLIGHT_CHECK=true yarn build && yarn inline-build && yarn _gen-pdf",
    "lint": "eslint ."
  },
  "eslintConfig": {
    "extends": [
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@formatjs/fast-memoize": "^3.1.6",
    "@storybook/addon-knobs": "^6.2.9",
